classDiagram
    %% Class Diagram — Core Domain, Scheduling & Model Gateway Abstractions

    class Clock {
        <<Protocol>>
        +now() datetime
    }
    class SystemClock {
        +now() datetime
    }
    class FakeClock {
        -_now: datetime
        +now() datetime
        +advance(delta)
        +set(value)
    }
    Clock <|.. SystemClock
    Clock <|.. FakeClock

    class Settings {
        +db_path: Path
        +timezone: str
        +hold_ttl_seconds: int
        +cancel_cutoff_minutes: int
        +model_max_rounds: int
        +model_max_tool_calls: int
        +model_cost_budget_usd: float
        +gps_max_age_minutes: int
    }

    class ModelGateway {
        <<Protocol>>
        +complete(messages, tools, policy) ModelResponse
    }
    class AnthropicAdapter
    class OpenAIAdapter
    class UnconfiguredGateway
    class ScriptedGateway
    class StubGateway
    ModelGateway <|.. AnthropicAdapter
    ModelGateway <|.. OpenAIAdapter
    ModelGateway <|.. UnconfiguredGateway
    ModelGateway <|.. ScriptedGateway
    ModelGateway <|.. StubGateway

    class ToolRegistry {
        +specs: dict~str, ToolSpec~
        +execute(call, ctx) ToolResult
    }
    class ToolContext {
        +driver_id: str
        +thread_id: str
        +message_id: str
        +message_text: str
        +turn: TurnOutcome
    }
    ToolRegistry --> ToolContext

    class FacilityState {
        +facility_id: str
        +as_of: datetime
        +slots: dict
        +docks: dict
        +effective_events()
        +slot_version(slot_id) str
        +rules_version() str
    }
    class FeasibilityContext {
        +shipment_id: str
        +release_time: datetime
        +eta_buffer_minutes: int
    }
    class FeasibilityDecision {
        +slot_id: str
        +status: str
        +reasons: tuple
        +digest() str
    }
    FacilityState --> FeasibilityDecision
    FeasibilityContext --> FeasibilityDecision

    class EscalationSink {
        <<Protocol>>
        +record(req) str
    }
    class SqlEscalationSink
    class JsonlEscalationSink
    EscalationSink <|.. SqlEscalationSink
    EscalationSink <|.. JsonlEscalationSink
