# Copy to .env. Never commit real secrets.
SETUHAUL_DB_PATH=data/setuhaul.sqlite3
SETUHAUL_TIMEZONE=Asia/Kolkata
SETUHAUL_REDIS_URL=redis://localhost:6379/0
# Approved provider/model are required before Phase 8; no key lives in the repo.
# anthropic | openai
SETUHAUL_MODEL_PROVIDER=
SETUHAUL_MODEL_ID=
SETUHAUL_MODEL_API_KEY=
# Optional: USD per million tokens, from your provider's price list, so the per-message cost stop works.
SETUHAUL_MODEL_PRICE_IN_PER_MTOK=
SETUHAUL_MODEL_PRICE_OUT_PER_MTOK=
# OpenAI only (optional): send temperature (some models reject it), or point at a compatible endpoint such as Azure OpenAI.
# SETUHAUL_OPENAI_SEND_TEMPERATURE=1
# Needed for reasoning models that refuse function tools by default (for example gpt-6-luna):
# SETUHAUL_OPENAI_REASONING_EFFORT=none
# SETUHAUL_OPENAI_BASE_URL=https://api.openai.com/v1

# LangSmith tracing of the LangGraph loop. OFF unless BOTH of the next two are set.
# Everything is scrubbed (phones, emails, secrets) before it is sent; set HIDE_TEXT=1 to hide all message text (use it for real drivers).
# SETUHAUL_LANGSMITH=approved
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=setuhaul
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# SETUHAUL_LANGSMITH_HIDE_TEXT=1

# Partner-warehouse requests by email. "simulated" (default) uses an in-memory demo mailbox; "live" sends and reads real mail.
# Gmail: turn on 2-Step Verification, create an App password (Google Account > Security > App passwords) and enable IMAP
# (Gmail > Settings > Forwarding and POP/IMAP). Use a dedicated mailbox: the service reads its inbox. Never use your normal password.
# SETUHAUL_PARTNER_EMAIL_MODE=live
# SETUHAUL_SMTP_HOST=smtp.gmail.com
# SETUHAUL_SMTP_PORT=465
# SETUHAUL_SMTP_USER=your.dedicated.mailbox@gmail.com
# SETUHAUL_SMTP_PASSWORD=<16-character app password>
# SETUHAUL_SMTP_FROM=your.dedicated.mailbox@gmail.com
# SETUHAUL_IMAP_HOST=imap.gmail.com
# SETUHAUL_IMAP_PORT=993
# SETUHAUL_IMAP_USER=your.dedicated.mailbox@gmail.com
# SETUHAUL_IMAP_PASSWORD=<16-character app password>
# SETUHAUL_IMAP_FOLDER=INBOX
# SETUHAUL_PARTNER_REQUEST_TTL_MIN=120
