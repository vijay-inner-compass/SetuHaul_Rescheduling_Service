# Copy to .env. Never commit real secrets.
# Note: .env is read by scripts/run_demo.py and a few other scripts. `uvicorn --factory setuhaul.api:create_app_from_env`
# does NOT load it: set the variables in the service's real environment.
SETUHAUL_DB_PATH=data/setuhaul.sqlite3
SETUHAUL_TIMEZONE=Asia/Kolkata
SETUHAUL_REDIS_URL=redis://localhost:6379/0
# Approved provider/model are required before Phase 8; no key lives in the repo.
# anthropic | openai
SETUHAUL_MODEL_PROVIDER=
SETUHAUL_MODEL_ID=
SETUHAUL_MODEL_API_KEY=
# Optional: USD per million tokens, from your provider's price list, so the per-message cost stop works.
SETUHAUL_MODEL_PRICE_IN_PER_MTOK=
SETUHAUL_MODEL_PRICE_OUT_PER_MTOK=
# OpenAI only (optional): send temperature (some models reject it), or point at a compatible endpoint such as Azure OpenAI.
# SETUHAUL_OPENAI_SEND_TEMPERATURE=1
# Needed for reasoning models that refuse function tools by default (for example gpt-6-luna):
# SETUHAUL_OPENAI_REASONING_EFFORT=none
# SETUHAUL_OPENAI_BASE_URL=https://api.openai.com/v1

# LangSmith tracing of the LangGraph loop. OFF unless BOTH of the next two are set.
# Everything is scrubbed (phones, emails, secrets) before it is sent; set HIDE_TEXT=1 to hide all message text (use it for real drivers).
# SETUHAUL_LANGSMITH=approved
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=setuhaul
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# SETUHAUL_LANGSMITH_HIDE_TEXT=1

# Partner-warehouse requests by email. "simulated" (default) uses an in-memory demo mailbox; "live" sends and reads real mail.
# Gmail: turn on 2-Step Verification, create an App password (Google Account > Security > App passwords) and enable IMAP
# (Gmail > Settings > Forwarding and POP/IMAP). Use a dedicated mailbox: the service reads its inbox. Never use your normal password.
# SETUHAUL_PARTNER_EMAIL_MODE=live
# SETUHAUL_SMTP_HOST=smtp.gmail.com
# SETUHAUL_SMTP_PORT=465
# SETUHAUL_SMTP_USER=your.dedicated.mailbox@gmail.com
# SETUHAUL_SMTP_PASSWORD=<16-character app password>
# SETUHAUL_SMTP_FROM=your.dedicated.mailbox@gmail.com
# SETUHAUL_IMAP_HOST=imap.gmail.com
# SETUHAUL_IMAP_PORT=993
# SETUHAUL_IMAP_USER=your.dedicated.mailbox@gmail.com
# SETUHAUL_IMAP_PASSWORD=<16-character app password>
# SETUHAUL_IMAP_FOLDER=INBOX
# SETUHAUL_PARTNER_REQUEST_TTL_MIN=120

# ---------------------------------------------------------------------------------------------------------------------
# Sign-in, roles and the Telegram driver bot. Setup steps: docs/running-and-demonstrating.md section 7a.
# Everything below is optional: a feature whose settings are missing stays off.

# Google sign-in. All three are needed: the client id and secret from your Google Cloud web OAuth client, and a random
# signing secret of at least 32 bytes (shorter: Google sign-in stays off). Redirect URI to register: <base>/auth/callback
# SETUHAUL_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
# SETUHAUL_GOOGLE_CLIENT_SECRET=<client-secret>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SETUHAUL_SESSION_SECRET=<at least 32 bytes>

# The public origin of the service: scheme, host and optional port, no path and no trailing slash. Set it behind any proxy
# or HTTPS terminator. It fixes the redirect URI and the Secure cookie flag, and is what the same-origin check compares
# with; without it a proxy that rewrites Host can cause 403 CROSS_SITE_REQUEST. A malformed value stops start-up.
# SETUHAUL_PUBLIC_URL=https://haul.example.com

# The first admin. At every start-up this address is made an ACTIVE ADMIN (created, or re-activated after a lockout or
# disable). While it is set, disabling that account lasts only until the next restart.
# SETUHAUL_BOOTSTRAP_ADMIN_EMAIL=<you@example.com>

# Break-glass password sign-in for admins, for when Google is unavailable. Off unless exactly 1.
# Set the password on the server: python scripts/set_admin_password.py <you@example.com>
# SETUHAUL_LOCAL_ADMIN=1

# Telegram bot (token from BotFather) and the secret Telegram sends back on each webhook call. Both are needed, and the
# secret must be at least 16 characters (Telegram allows A-Z a-z 0-9 _ -), otherwise the webhook route stays off (503).
# SETUHAUL_TELEGRAM_BOT_TOKEN=<bot-token>
# SETUHAUL_TELEGRAM_WEBHOOK_SECRET=<at least 16 characters>

# Service-to-service access to the case routes, as a JSON map {"<token>": "<name>"}. Not scoped to facilities.
# Names may not start with "web:".
# SETUHAUL_COORDINATOR_TOKENS={}
# Shared secret of the HMAC-signed driver/GPS channel (not the Telegram secret).
# SETUHAUL_WEBHOOK_SECRET=
